# Copy to .env.local and fill in. Never commit real values.
# Every variable below is validated in src/lib/env.ts the first time it is needed.

# MongoDB Atlas connection string for your own dev cluster (a free cluster is fine locally).
# Production uses the M10 cluster in Mumbai (ap-south-1).
MONGODB_URI=

# Database name. Use a separate name per environment so dev data never touches production.
MONGODB_DB=makemymarriage_dev

# Root domain that wedding sites are served under as <slug>.<root>. Port is ignored for matching.
# Local: demo.localhost:3000 opens the site for slug "demo" (Chrome and Firefox resolve *.localhost).
# Production: makemymarriage.com
APP_ROOT_DOMAIN=localhost:3000
