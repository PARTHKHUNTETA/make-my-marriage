# Copy to .env.local and fill in. Never commit real values.
# Every variable below is validated in src/lib/env.ts the first time it is needed.

# MongoDB Atlas connection string for your own dev cluster (a free cluster is fine locally).
# Production uses the M10 cluster in Mumbai (ap-south-1).
MONGODB_URI=

# Database name. Use a separate name per environment so dev data never touches production:
# makemymarriage_dev here, makemymarriage_prod (ideally on its own cluster) in production. Pair
# each database with its own R2 bucket: a photo's record and its file must live in the same
# environment, or the photo shows as an empty tile.
MONGODB_DB=makemymarriage_dev

# The app's own domain. Every shared link (gallery, invitations, the wedding website, emails) is
# built from it, and wedding sites are also served as <slug>.<root>. Port is ignored for matching.
# Local: localhost:3000 (demo.localhost:3000 opens the site for slug "demo").
# Production: make-my-marriage.shop. Leaving it at localhost in production makes every shared link
# point at localhost.
APP_ROOT_DOMAIN=localhost:3000

# Secret that signs session cookies. At least 32 random characters; use a different value per
# environment. Generate one with:  openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=

# Email. Without RESEND_API_KEY, emails are printed to the server log in development (the
# verification and reset links appear there). Production needs a key from resend.com and a
# verified sending domain; until the domain is verified, Resend only delivers to your own address.
RESEND_API_KEY=
EMAIL_FROM="Make My Marriage <onboarding@resend.dev>"

# Shared secret for the cron routes (the email queue drain). At least 32 random characters.
# On Vercel, setting CRON_SECRET makes Vercel Cron send it automatically.
CRON_SECRET=


# Comma-separated emails of the Make My Marriage team. A signed-in member with a verified email on
# this list can approve marketplace listings at /staff. Leave empty for no staff access.
STAFF_EMAILS=

# Photo storage on Cloudflare R2. Leave all four empty in development to use a folder on this
# computer instead. In production all four are required.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Photo storage each wedding gets, in gigabytes (default 10).
PHOTO_QUOTA_GB=

# Where people write to us (shown on the Privacy, Terms and Support pages). Set before launch.
SUPPORT_EMAIL=

# Google Places API (New) key for Discover vendors. Server-side only; restrict it to the Places API.
# Leave empty and the Discover page shows that it is not set up.
GOOGLE_PLACES_API_KEY=

# AI writing for the wedding website ("Write with AI" on /website). Pick a provider and set its key;
# without a key the panel is hidden. AI_MODEL is optional (defaults: claude-opus-5-5 / gpt-5).
AI_PROVIDER=anthropic
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
