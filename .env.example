# Copy to .env.local and fill in. Never commit real values.
# Every variable below is validated in src/lib/env.ts the first time it is needed.

# MongoDB Atlas connection string for your own dev cluster (a free cluster is fine locally).
# Production uses the M10 cluster in Mumbai (ap-south-1).
MONGODB_URI=

# Database name. Use a separate name per environment so dev data never touches production.
MONGODB_DB=makemymarriage_dev

# Root domain that wedding sites are served under as <slug>.<root>. Port is ignored for matching.
# Local: demo.localhost:3000 opens the site for slug "demo" (Chrome and Firefox resolve *.localhost).
# Production: makemymarriage.com
APP_ROOT_DOMAIN=localhost:3000

# Secret that signs session cookies. At least 32 random characters; use a different value per
# environment. Generate one with:  openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=

# Email. Without RESEND_API_KEY, emails are printed to the server log in development (the
# verification and reset links appear there). Production needs a key from resend.com and a
# verified sending domain; until the domain is verified, Resend only delivers to your own address.
RESEND_API_KEY=
EMAIL_FROM="Make My Marriage <onboarding@resend.dev>"

# Shared secret for the cron routes (the email queue drain). At least 32 random characters.
# On Vercel, setting CRON_SECRET makes Vercel Cron send it automatically.
CRON_SECRET=


# Comma-separated emails of the Make My Marriage team. A signed-in member with a verified email on
# this list can approve marketplace listings at /staff. Leave empty for no staff access.
STAFF_EMAILS=
